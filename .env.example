# ==========================================
# POLYMARKET COPY TRADING BOT - ENV CONFIG
# ==========================================

# 1. Server Configuration
PORT=3000
NODE_ENV=development

# 2. Polygon RPC Endpoint
# Default free public RPC or provide your own Alchemy/Infura/Pocket RPC URL
RPC_URL=https://poly.api.pocket.network

# 3. Polymarket Wallet Credentials
# Your Ethereum/Polygon Private Key (must start with 0x)
PRIVATE_KEY=0xyour_private_key_here

# 4. Polymarket CLOB API Credentials
# JSON string containing your Polymarket API key, secret, and passphrase.
# You can generate this by running: npx ts-node src/utils/generate-api-credits.ts (with PRIVATE_KEY set)
POLYMARKET_API_CREDS={"key":"your-api-key","secret":"your-api-secret","passphrase":"your-passphrase"}

# 5. Optional: Proxy / Smart Wallet Funder Address
# Only needed if you trade through a proxy wallet or smart contract on Polymarket
# FUNDER_ADDRESS=0x...
